<Window x:Class="Aisteria.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help — AIsteria Aggregator" Height="620" Width="760" Icon="app.ico"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" MinWidth="90"
                HorizontalAlignment="Right" Margin="0,10,0,0" Click="btnClose_Click"/>
        <TabControl>
            <TabItem Header="Overview">
                <TextBox x:Name="txtOverview" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" Padding="6"/>
            </TabItem>
            <TabItem Header="Shortcuts">
                <TextBox x:Name="txtShortcuts" IsReadOnly="True" FontFamily="Consolas" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6"/>
            </TabItem>
            <TabItem Header="Providers">
                <TextBox x:Name="txtProviders" IsReadOnly="True" FontFamily="Consolas" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6"/>
            </TabItem>
            <TabItem Header="Tips">
                <TextBox x:Name="txtTips" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" Padding="6"/>
            </TabItem>
            <TabItem Header="License">
                <TextBox x:Name="txtLicense" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" Padding="6"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
