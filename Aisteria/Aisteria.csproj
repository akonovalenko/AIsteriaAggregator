<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net6.0-windows;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <AssemblyName>AIsteriaAggregator</AssemblyName>
    <RootNamespace>Aisteria</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- System.Text.Json ships in the shared framework on both net6 and net8, so no package
       reference is needed (the old System.Text.Json 6.0.0 reference had a known vulnerability). -->

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aisteria.Tests" />
  </ItemGroup>

</Project>
