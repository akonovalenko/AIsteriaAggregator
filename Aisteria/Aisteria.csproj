<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net6.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
		<UseWPF>true</UseWPF>
		<!-- Allow a net6 framework-dependent build to run on newer major runtimes (e.g., .NET 10) -->
		<RollForward>LatestMajor</RollForward>
		<Nullable>disable</Nullable>
		<AssemblyName>AIsteriaAggregator</AssemblyName>
		<RootNamespace>Aisteria</RootNamespace>
		<ApplicationIcon>app.ico</ApplicationIcon>

		<!-- Application version properties -->
		<Version>1.0.3.2</Version>
		<AssemblyVersion>1.0.3.2</AssemblyVersion>
		<FileVersion>1.0.3.2</FileVersion>
		<AssemblyFileVersion>1.0.3.2</AssemblyFileVersion>
		<InformationalVersion>1.0.3.2</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="app.ico" />
	</ItemGroup>

	<!-- System.Text.Json ships in the shared framework on both net6 and net8, so no package
       reference is needed (the old System.Text.Json 6.0.0 reference had a known vulnerability). -->

	<ItemGroup>
		<None Update="App.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Aisteria.Tests" />
	</ItemGroup>

</Project>