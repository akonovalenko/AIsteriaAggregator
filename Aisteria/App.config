<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- API keys are stored encrypted in %APPDATA%\Aisteria\settings.config. -->
    <!-- Models -->
    <add key="OpenAIModel"        value="gpt-4o-mini" />
    <add key="OpenAIVisionModel"  value="gpt-4o" />
    <add key="GeminiModel"         value="gemini-3.8-flash" />
    <add key="GroqModel"           value="openai/gpt-oss-120b" />
    <add key="GroqVisionModel"     value="qwen/qwen3.8-27b" />
    <add key="DeepSeekModel"       value="deepseek-chat" />
    <add key="MistralModel"        value="mistral-small-latest" />
    <add key="MistralVisionModel"  value="mistral-small-latest" />
    <add key="OpenRouterModel"     value="deepseek/deepseek-r1" />
    <add key="OpenRouterVisionModel" value="openrouter/free" />
    <add key="GitHubModel"         value="gpt-4o-mini" />
    <add key="GitHubVisionModel"   value="gpt-4o" />
    <add key="NvidiaModel"         value="nvidia/nemotron-3-super-120b-a12b" />
    <add key="NvidiaVisionModel"   value="deepseek-ai/deepseek-v4.1-flash" />
    <add key="OllamaCloudModel"    value="gpt-oss:120b-cloud" />
    <add key="OllamaCloudVisionModel" value="" />
    <add key="ClaudeModel"         value="claude-haiku-4-5-20251001" />
    <add key="PerplexityModel"     value="sonar" />
    <!-- Local Ollama and generation defaults -->
    <add key="OllamaUrl" value="http://localhost:11434" />
    <add key="OllamaModel" value="" />
    <add key="Temperature" value="" />
    <add key="MaxTokens" value="8192" />
    <add key="SystemPrompt" value="" />

    <!-- Provider enabled flags -->
    <add key="OpenAIEnabled"     value="true" />
    <add key="GeminiEnabled"     value="true" />
    <add key="OllamaEnabled"     value="true" />
    <add key="GroqEnabled"       value="true" />
    <add key="DeepSeekEnabled"   value="true" />
    <add key="MistralEnabled"    value="true" />
    <add key="OpenRouterEnabled" value="true" />
    <add key="GitHubEnabled"     value="true" />
    <add key="NvidiaEnabled"     value="true" />
    <add key="OllamaCloudEnabled" value="true" />
    <add key="ClaudeEnabled"     value="true" />
    <add key="PerplexityEnabled" value="true" />

    <!-- Verbose logging defaults -->
    <add key="VerboseLogging" value="false" />
    <!-- Endpoints (plain text, edit manually if needed) -->
    <add key="OpenAIBaseUrl"      value="https://api.openai.com/v1" />
    <add key="GeminiUrl"          value="https://generativelanguage.googleapis.com/v1beta/interactions" />
    <add key="GroqBaseUrl"        value="https://api.groq.com/openai/v1" />
    <add key="DeepSeekBaseUrl"    value="https://api.deepseek.com/v1" />
    <add key="MistralBaseUrl"     value="https://api.mistral.ai/v1" />
    <add key="OpenRouterBaseUrl"  value="https://openrouter.ai/api/v1" />
    <add key="GitHubBaseUrl"      value="https://models.inference.ai.azure.com" />
    <add key="NvidiaBaseUrl"      value="https://integrate.api.nvidia.com/v1" />
    <add key="OllamaCloudBaseUrl" value="https://ollama.com/v1" />
    <add key="ClaudeBaseUrl"          value="https://api.anthropic.com" />
    <add key="PerplexityBaseUrl"      value="https://api.perplexity.ai" />
  </appSettings>
</configuration>
